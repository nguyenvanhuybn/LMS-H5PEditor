NEXT_PUBLIC_API_URL=http://localhost:5050

# Server-side only. Held by the package download route so the browser never
# sees it — the same key also unlocks every learner's results.
# Must match Integration__ApiKey on the ASP.NET API.
INTEGRATION_API_KEY=dev-integration-key-change-me

# Optional: server-to-server URL of the API when it differs from the public one
# (e.g. inside Docker). Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:5050
