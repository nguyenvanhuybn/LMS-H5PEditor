<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Requires IIS URL Rewrite 2.1 and Application Request Routing (ARR). -->
    <proxy enabled="true" preserveHostHeader="true" reverseRewriteHostInResponseHeaders="false" />
    <security>
      <requestFiltering>
        <!-- 110 MB: accommodates the application's 100 MB H5P upload limit. -->
        <requestLimits maxAllowedContentLength="115343360" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="API backend" stopProcessing="true">
          <match url="^backend/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5050/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="H5P engine" stopProcessing="true">
          <match url="^h5p-engine/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="Next.js frontend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
