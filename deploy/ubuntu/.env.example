# The host/IP users open in their browser. Change to an HTTPS domain later.
PUBLIC_ORIGIN=http://10.0.0.120:8081

# Generate different values with: openssl rand -base64 32
H5P_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
H5P_INTERNAL_API_KEY=replace-with-a-random-internal-api-key
INTEGRATION_API_KEY=replace-with-a-random-integration-api-key

# Origins allowed to embed an exported SCORM/xAPI package. "*" accepts any LMS
# and removes the origin picker from the export dialog. Applied to BOTH
# Integration__AllowedLmsOrigins and H5P_ALLOWED_ORIGINS — they must agree, or
# results never reach the LMS. Set an explicit origin to restrict, e.g.
# LMS_ORIGINS=http://lms.thienhoang.net:3002
LMS_ORIGINS=*

# Forward xAPI statements to an external LRS (optional).
LRS_ENABLED=false
LRS_ENDPOINT=
LRS_USERNAME=
LRS_PASSWORD=
