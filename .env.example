# Frontend (compiled into browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:5050
# Chỉ dùng phía server của Next; route tải gói giữ khoá này để trình duyệt
# không bao giờ thấy nó. Phải khớp Integration__ApiKey của ASP.NET.
INTEGRATION_API_KEY=replace-with-a-long-random-integration-key
API_INTERNAL_URL=http://localhost:5050

# ASP.NET Core
H5p__InternalUrl=http://localhost:3001
H5p__PublicUrl=http://localhost:3000/h5p-engine
H5p__WebhookSecret=replace-with-a-long-random-secret
H5p__InternalApiKey=replace-with-another-long-random-secret

# Tích hợp LMS ngoài: khoá LMS gửi trong header X-Api-Key.
# Để trống thì /api/integration/* bị tắt hẳn thay vì mở toang.
Integration__ApiKey=replace-with-a-long-random-integration-key
# Origin của LMS được phép nhúng gói SCORM. Origin này CŨNG phải có trong
# H5P_ALLOWED_ORIGINS bên dưới, nếu không player sẽ không gửi được kết quả về LMS.
Integration__AllowedLmsOrigins__0=https://lms.example.com

# Chuyển tiếp statement xAPI sang LRS (tuỳ chọn)
Lrs__Enabled=false
Lrs__Endpoint=https://lrs.example.com/data/xAPI
Lrs__Username=
Lrs__Password=
Lrs__ActorHomePage=https://lms.example.com

# H5P Engine
PORT=3001
H5P_BASE_URL=http://localhost:3000/h5p-engine
# PHẢI chứa mọi origin trong Integration__AllowedLmsOrigins ở trên. Thiếu thì gói
# SCORM/xAPI vẫn chạy nhưng kết quả không bao giờ về tới LMS.
H5P_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://lms.example.com
H5P_PARENT_ORIGIN=http://localhost:3000
H5P_ENGINE_INTERNAL_URL=http://localhost:3001
H5P_WEBHOOK_URL=http://localhost:5050/api/h5p/xapi
H5P_WEBHOOK_SECRET=replace-with-the-same-webhook-secret
H5P_INTERNAL_API_KEY=replace-with-the-same-internal-api-key
# Ngôn ngữ editor/player. Phần tử đầu là mặc định.
# Giữ khớp với H5p__SupportedLanguages__0/1 của ASP.NET Core.
H5P_SUPPORTED_LANGUAGES=vi,en
